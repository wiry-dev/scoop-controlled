{
  "version": "26.6",
  "description": "Enhanced terminal for Windows with X11 server, tabbed SSH client, network tools and much more.",
  "homepage": "https://mobaxterm.mobatek.net",
  "license": {
    "identifier": "Freeware",
    "url": "https://mobaxterm.mobatek.net/license.html"
