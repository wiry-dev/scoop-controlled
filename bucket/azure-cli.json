    "__sourceLicenceOpen: true",
    "__sourceState: active",
    "__sourceUpdateMinimumDays: 7",
    "__sourceUrl: https://raw.githubusercontent.com/ScoopInstaller/Main/master/bucket/azure-cli.json"
  ]
}
