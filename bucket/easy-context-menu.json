  "pre_install": "New-Item \"$dir\\Files\\EcMenu.ini\" -ItemType 'File' | Out-Null",
  "architecture": {
    "32bit": {
      "pre_install": "Remove-Item \"$dir\\EcMenu_x64.exe\" | Out-Null",
      "shortcuts": [
        [
          "EcMenu.exe",
          "Easy Context Menu"
        ]
      ]
    },
    "64bit": {
